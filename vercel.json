{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/attendance-report.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/attendance-report",
      "schedule": "0 4 * * *"
    }
  ]
}
